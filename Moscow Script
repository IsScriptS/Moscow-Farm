-- Функция поиска целевой модели
local function findTargetModel()
    local map = workspace:FindFirstChild("Map")
    
    -- Ищем в Map любую model с GUID {c9613e79-7ac7-40b0-a418-922f53648102}
    if map then
        for _, child in ipairs(map:GetChildren()) do
            if child:IsA("Model") then
                local eggPart = child:FindFirstChild("{c9613e79-7ac7-40b0-a418-922f53648102}")
                if eggPart and eggPart:IsA("BasePart") then
                    return eggPart
                end
            end
        end
    end
    
    -- Ищем модель Pine 4 с GUID {19eb907f-38d0-4704-9fe5-d3b7ce8d0ee3}
    local pine4 = workspace:FindFirstChild("Pine 4")
    if pine4 and pine4:IsA("Model") then
        local eggPart = pine4:FindFirstChild("{19eb907f-38d0-4704-9fe5-d3b7ce8d0ee3}")
        if eggPart and eggPart:IsA("BasePart") then
            return eggPart
        end
    end
    
    return nil
end

