-- Анимация пульсации для кнопки
local function pulseAnimation()
    local tween1 = TweenService:Create(farmBtn, TweenInfo.new(0.5), {BackgroundColor3 = Color3.fromRGB(100, 200, 100)})
    local tween2 = TweenService:Create(farmBtn, TweenInfo.new(0.5), {BackgroundColor3 = Color3.fromRGB(76, 175, 80)})
    tween1:Play()
    tween1.Completed:Connect(function()
        tween2:Play()
    end)
end

-- Переменные для перетаскивания
local dragStart = nil
local dragStarted = false
local frameStartPos = nil

topBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStart = input.Position
        dragStarted = true
        frameStartPos = mainFrame.Position
    end
end)

UserInputService.InputChanged:Connect(function(input)
    if dragStarted and input.UserInputType == Enum.UserInputType.MouseMovement then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(frameStartPos.X.Scale, frameStartPos.X.Offset + delta.X, frameStartPos.Y.Scale, frameStartPos.Y.Offset + delta.Y)
    end
end)

UserInputService.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragStarted = false
    end
end)

-- Функция телепортации
local isFarming = false
local farmTask = nil

local function teleportToEgg()
    local target = findTargetModel()
    
    if target and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        local oldCFrame = hrp.CFrame
        
        -- Телепортируем
        hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
        
        -- Визуальный эффект
        statusText.Text = "✅ Телепортирован!"
        statusText.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        -- Анимация кнопки
        local flash = TweenService:Create(farmBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(60, 140, 60)})
        flash:Play()
        flash.Completed:Connect(function()
            local back = TweenService:Create(farmBtn, TweenInfo.new(0.1), {BackgroundColor3 = Color3.fromRGB(76, 175, 80)})
            back:Play()
        end)
        
        task.wait(0.8)
        statusText.Text = "✨ Фармим... ✨"
        statusText.TextColor3 = Color3.fromRGB(255, 200, 100)
    elseif not target then
        statusText.Text = "❌ Яйцо не найдено!"
        statusText.TextColor3 = Color3.fromRGB(255, 80, 80)
        task.wait(2)
        statusText.Text = "✨ Готов к работе ✨"
        statusText.TextColor3 = Color3.fromRGB(180, 180, 220)
    end
end

-- Запуск/остановка фарма
local function startFarming()
    if isFarming then return end
    isFarming = true
    
    farmBtn.BackgroundColor3 = Color3.fromRGB(220, 80, 80)
    farmBtn.Text = "⏹️ ОСТАНОВИТЬ ⏹️"
    statusText.Text = "🐣 Фармим яйца... 🐣"
    statusText.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    farmTask = task.spawn(function()
        while isFarming do
            teleportToEgg()
            task.wait(2)
        end
    end)
end

local function stopFarming()
    isFarming = false
    if farmTask then
        task.cancel(farmTask)
        farmTask = nil
    end
    farmBtn.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
    farmBtn.Text = "🥚 НАЧАТЬ ФАРМ 🥚"
    statusText.Text = "✨ Фарм остановлен ✨"
    statusText.TextColor3 = Color3.fromRGB(180, 180, 220)
    task.wait(1)
    statusText.Text = "✨ Готов к работе ✨"
end

-- Нажатие на кнопку
farmBtn.MouseButton1Click:Connect(function()
    if isFarming then
        stopFarming()
    else
        startFarming()
    end
    pulseAnimation()
end)

