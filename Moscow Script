-- Функция поиска целевой модели
local function findTargetModel()
    local map = workspace:FindFirstChild("Map")
    if not map then
        statusLabel.Text = "❌ Папка Map не найдена!"
        return nil
    end
    
    -- Ищем модель с GUID {c9613e79-7ac7-40b0-a418-922f53648102}
    for _, model in ipairs(map:GetChildren()) do
        if model:IsA("Model") then
            local targetPart = model:FindFirstChild("{c9613e79-7ac7-40b0-a418-922f53648102}")
            if targetPart and targetPart:IsA("BasePart") then
                return targetPart
            end
        end
    end
    
    -- Ищем модель Pine 4 и в ней GUID {19eb907f-38d0-4704-9fe5-d3b7ce8d0ee3}
    local pine4 = workspace:FindFirstChild("Pine 4")
    if pine4 and pine4:IsA("Model") then
        local targetPart = pine4:FindFirstChild("{19eb907f-38d0-4704-9fe5-d3b7ce8d0ee3}")
        if targetPart and targetPart:IsA("BasePart") then
            return targetPart
        end
    end
    
    statusLabel.Text = "⚠️ Яйцо не найдено!"
    return nil
end

-- Функция телепортации
local function teleportToEgg()
    local target = findTargetModel()
    if target and player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
        local hrp = player.Character.HumanoidRootPart
        hrp.CFrame = target.CFrame + Vector3.new(0, 3, 0)
        statusLabel.Text = "✅ Телепортирован к яйцу!"
        statusLabel.TextColor3 = Color3.fromRGB(100, 255, 100)
        
        -- Анимация кнопки при успехе
        local tween = TweenService:Create(farmButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(60, 140, 60)})
        tween:Play()
        task.wait(0.2)
        local tween2 = TweenService:Create(farmButton, TweenInfo.new(0.2), {BackgroundColor3 = Color3.fromRGB(76, 175, 80)})
        tween2:Play()
        
        task.wait(1)
        statusLabel.Text = "⚡ Готов к фарму"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    elseif not target then
        statusLabel.Text = "❌ Яйцо не найдено!"
        statusLabel.TextColor3 = Color3.fromRGB(255, 100, 100)
        task.wait(2)
        statusLabel.Text = "⚡ Готов к фарму"
        statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    end
end

-- Запуск фарма по интервалу
local farming = false
local farmConnection = nil

local function startFarming()
    if farming then return end
    farming = true
    farmButton.BackgroundColor3 = Color3.fromRGB(220, 80, 80)
    farmButton.Text = "⏹️ ОСТАНОВИТЬ ⏹️"
    statusLabel.Text = "🐣 Фармим яйца каждые 2 секунды..."
    statusLabel.TextColor3 = Color3.fromRGB(255, 200, 100)
    
    farmConnection = game:GetService("RunService").Stepped:Connect(function()
        -- Не делаем ничего, просто держим соединение
    end)
    
    -- Основной цикл
    task.spawn(function()
        while farming do
            teleportToEgg()
            task.wait(2)
        end
    end)
end

local function stopFarming()
    farming = false
    if farmConnection then
        farmConnection:Disconnect()
        farmConnection = nil
    end
    farmButton.BackgroundColor3 = Color3.fromRGB(76, 175, 80)
    farmButton.Text = "🥚 ФАРМ ЯИЦ 🥚"
    statusLabel.Text = "⚡ Фарм остановлен"
    statusLabel.TextColor3 = Color3.fromRGB(150, 150, 150)
    task.wait(1)
    statusLabel.Text = "⚡ Готов к фарму"
end

-- Обработчик кнопки
farmButton.MouseButton1Click:Connect(function()
    if farming then
        stopFarming()
    else
        startFarming()
    end
end)

